# Face Ride Connect — Backend Configuration Example
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.

# Flask
BACKEND_PORT=5001

# Arduino (serial port where the Arduino is connected)
ARDUINO_PORT=COM7
ARDUINO_BAUD=9600

# Face recognition
FACE_THRESHOLD=0.65

# Fare system
FARE_PER_STOP=5

# Admin credentials (change before using)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
